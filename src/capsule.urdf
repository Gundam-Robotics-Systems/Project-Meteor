<?xml version="1.0"?>
<robot name="gundam_satellite_reentry_capsule">

  <!-- Core Armored Capsule Body -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.45" rpy="0 0 0"/>
      <mass value="45000.0"/>
      <inertia ixx="1540125.0" ixy="0.0" ixz="0.0" iyy="1540125.0" iyz="0.0" izz="1540125.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="9.25"/>
      </geometry>
      <material name="hull_gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="9.25"/>
      </geometry>
    </collision>
  </link>

  <!-- Heavy Internal Structural Shock Dampener Joint -->
  <link name="internal_cargo_cradle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5000.0"/>
      <inertia ixx="45000.0" ixy="0.0" ixz="0.0" iyy="45000.0" iyz="0.0" izz="45000.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="12.0 12.0 16.5"/>
      </geometry>
      <material name="frame_dark">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="cradle_isolation_suspension" type="prismatic">
    <parent link="base_link"/>
    <child link="internal_cargo_cradle"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="500000" velocity="10"/>
    <dynamics damping="15000.0" friction="500.0"/>
  </joint>

</robot>
